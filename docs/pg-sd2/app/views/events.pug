extends websitelayout

block styles
  link(rel="stylesheet", href="/style/events.css")

block content
    .tournaments-page

        h1.page-title Events

        //- ── FEATURED TOURNAMENT ──
        if featured
          .featured-card
            p.featured-label ⭐ Featured Event
            .featured-body
              .featured-left
                h2.featured-title= featured.title
                p.featured-desc= featured.description || featured.skill_level || ''
                .featured-meta
                  .meta-row
                    span 🎮
                    | &nbsp;Game:&nbsp;
                    span.meta-val= featured.game_name || 'TBC'
                  .meta-row
                    span 📅
                    | &nbsp;Date:&nbsp;
                    - var d = featured.start_date || featured.date
                    span.meta-val= d ? new Date(d).toLocaleDateString('en-GB', {day:'numeric', month:'long', year:'numeric'}) : 'TBC'
                  if featured.prize
                    .meta-row
                      span 🏆
                      | &nbsp;Prize:&nbsp;
                      span.meta-val= featured.prize
                  .meta-row
                    span 🔢
                    | &nbsp;Slots Left:&nbsp;
                    span.meta-val= (featured.max_participants || 20) - (featured.participant_count || 0)
                - var featExpired = featured.date && new Date(featured.date) < new Date()
                .featured-btns
                  if featExpired
                    a.btn-primary(href='/events/' + featured.EventID) Join Event
                  else if Logged
                    form(action='/events/' + featured.EventID + '/join', method='POST', style='display:inline')
                      button.btn-primary(type='submit') Join Event
                  else
                    a.btn-primary(href='/login?redirect=/events/' + featured.EventID) Join Event
                  a.btn-outline(href='/events/' + featured.EventID) View Details

              .featured-right
                .trophy 🏆
                .featured-stats
                  - var featMax = featured.max_participants || 20
                  - var featTaken = featured.participant_count || 0
                  - var featLeft = featMax - featTaken
                  .stat-box
                    .stat-num= featTaken
                    .stat-lbl Teams
                  .stat-box
                    .stat-num= featLeft
                    .stat-lbl Slots Left
                  .stat-box
                    .stat-num(style=(featLeft <= 0 ? 'color:#f87171' : 'color:#4ade80'))= featLeft <= 0 ? 'Full' : 'Open'
                    .stat-lbl Status

        //- ── FIND A EVENT ──
        .section-header
          h2.section-title Find a Event
          .search-box
            input(type='text', placeholder='Search Events...', id='searchInput', oninput='searchCards()')

        .filter-tags
          button.filter-tag.active(onclick='filterTags(this, "all")') All
          button.filter-tag(onclick='filterTags(this, "beginner")') Beginner
          button.filter-tag(onclick='filterTags(this, "intermediate")') Intermediate
          button.filter-tag(onclick='filterTags(this, "advanced")') Advanced

        //- ── TOURNAMENT CARDS ──
        if events && events.length
          .cards-grid#cardsGrid
            each event in events
              .t-card(data-tag=(event.Skill_level || '').toLowerCase(), data-title=(event.title || event.Event_Name || '').toLowerCase())
                .t-card__title= event.title || event.Event_Name
                p.t-card__desc= event.description || event.Skill_level || ''
                .t-card__meta
                  .t-card__meta-row
                    span 🎮
                    | &nbsp;#{event.game_name || 'TBC'}
                  .t-card__meta-row
                    - var ed = event.start_date || event.date
                    span 📅
                    | &nbsp;#{ed ? new Date(ed).toLocaleDateString('en-GB', {day:'numeric', month:'short', year:'numeric'}) : 'TBC'}
                  if event.prize
                    .t-card__meta-row
                      span 🏆
                      | &nbsp;#{event.prize}
                - var cardExpired = event.date && new Date(event.date) < new Date()
                .t-card__btns
                  if cardExpired
                    a.btn-sm-primary(href='/events/' + event.EventID) Join
                  else if Logged
                    form(action='/events/' + event.EventID + '/join', method='POST', style='display:inline;flex:1')
                      button.btn-sm-primary(type='submit', style='width:100%') Join
                  else
                    a.btn-sm-primary(href='/login?redirect=/events/' + event.EventID) Join
                  a.btn-sm-outline(href='/events/' + event.EventID) Details
          p.empty-state#emptyState(style='display:none') No events match your search. 🎮
        else
          p.empty-state No upcoming events right now. Check back soon! 🎮


    script.
      var activeTag = 'all';

      function applyFilters() {
        var search = document.getElementById('searchInput').value.toLowerCase().trim();
        var cards = document.querySelectorAll('#cardsGrid .t-card');
        var visible = 0;
        cards.forEach(function(card) {
          var title = card.getAttribute('data-title') || '';
          var tag   = card.getAttribute('data-tag') || '';
          var matchSearch = search === '' || title.includes(search);
          var matchTag    = activeTag === 'all' || tag === activeTag;
          var show = matchSearch && matchTag;
          card.style.display = show ? '' : 'none';
          if (show) visible++;
        });
        var empty = document.getElementById('emptyState');
        if (empty) empty.style.display = visible === 0 ? '' : 'none';
      }

      function searchCards() { applyFilters(); }

      function filterTags(btn, tag) {
        activeTag = tag;
        document.querySelectorAll('.filter-tag').forEach(function(b) {
          b.classList.remove('active');
        });
        btn.classList.add('active');
        applyFilters();
      }

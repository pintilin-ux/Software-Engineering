extends websitelayout

block styles
  link(rel="stylesheet", href="/style/profile.css")

block content
  .profile-shell
    .profile-panel

      .profile-topbar
        .profile-brand Bare Minimum Legends
        a.profile-edit(href="#") Edit Profile

      .profile-main
        .profile-left
          h1.profile-title Profile

          .profile-avatar-row
            .profile-avatar
            .profile-name-block
              h2= user.username
              p.profile-subtitle= user.email

          .profile-bio-card
            h3 About
            p= user.bio

            .profile-meta
              p
                strong Joined:
                |  #{user.joined}
              p
                strong Favourite Game:
                |  #{user.favouriteGame}
              p
                strong Skill Level:
                |  #{user.skillLevel}
              p
                strong Platform:
                |  #{user.platform}

        .profile-right
          .overview-card
            h3 Overview
            .overview-row
              span Tips Created
              strong= stats.tipsCreated
            .overview-row
              span Tips Saved
              strong= stats.tipsSaved
            .overview-row
              span Tips Liked
              strong= stats.tipsLiked

          .graph-card
            h3 Activity
            .graph-grid
              span.graph-box
              span.graph-box
              span.graph-box
              span.graph-box
              span.graph-box
              span.graph-box
              span.graph-box
              span.graph-box

      .profile-bottom
        .event-column
          h3 My Tips
          if tips && tips.length
            each tip in tips
              .event-card
                h4= tip.title
                p
                  strong Game:
                  |  #{tip.game}
                p
                  strong Date:
                  |  #{tip.date}
                p= tip.summary
          else
            .event-card
              h4 No tips yet
              p This user has not created any tips yet.
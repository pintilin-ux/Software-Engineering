extends websitelayout

block styles
  link(rel="stylesheet", href="/style/profile.css")

block content
  header.navbar
    .logo Bare Minimum Legends
    nav.nav-links
      a(href="/") Home
      a(href="#") Browse
      a(href="/profile") Profile
      a(href="#") Create Tip
      a(href="#") Logout

  main.profile-page
    section.profile-card
      .profile-left
        .avatar-circle

        .profile-info
          h2= user.username
          p
            strong Email:
            |  #{user.email}
          p
            strong Bio:
            |  #{user.bio}
          p
            strong Joined:
            |  #{user.joined}
          p
            strong Favourite Game:
            |  #{user.favouriteGame}
          p
            strong Skill Level:
            |  #{user.skillLevel}
          p
            strong Platform:
            |  #{user.platform}

      .profile-right
        button.edit-btn Edit Profile

    section.activity-section
      h3 User Activity
      .activity-cards
        .activity-card
          h4 Tips Created
          p= stats.tipsCreated
        .activity-card
          h4 Tips Saved
          p= stats.tipsSaved
        .activity-card
          h4 Tips Liked
          p= stats.tipsLiked

    section.tabs
      button.tab-btn.active My Tips
      button.tab-btn Saved Tips
      button.tab-btn Activity

    section.placeholder-section
      .placeholder-card
        h4 Saved Tips
        p No saved tips yet. This section will display bookmarked or saved guides in a future version.
      .placeholder-card
        h4 Recent Activity
        p No recent activity yet. This section will show likes, interactions and community engagement in a future version.

    section.tips-list
      each tip in tips
        .tip-item
          .tip-thumbnail-box

          .tip-details
            h4= tip.title
            p
              strong Game:
              |  #{tip.game}
            p
              strong Date:
              |  #{tip.date}
            p.tip-summary= tip.summary

          .tip-actions
            a.btn(href="#") Edit
            a.btn(href="#") Delete
            a.btn(href="#") View

  footer.footer
    p Bare Minimum Legends 2026
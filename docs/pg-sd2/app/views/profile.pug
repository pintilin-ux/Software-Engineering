extends websitelayout

block styles
  link(rel="stylesheet", href="/style/profile.css")

block content
  .profile-shell
    .profile-panel

      .profile-topbar
        .profile-brand Bare Minimum Legends

      .profile-main
        .profile-left
          h1.profile-title Profile

          .profile-avatar-row
            .profile-avatar
            .profile-name-block
              h2= user.username
              p.profile-subtitle= user.email

          .profile-bio-card
            h3 About
            p= user.bio

            .profile-meta
              p
                strong Joined:
                |  #{user.joined}
              p
                strong Favourite Game:
                |  #{user.favouriteGame}
              p
                strong Skill Level:
                |  #{user.skillLevel}
              p
                strong Platform:
                |  #{user.platform}

        .profile-right
          .overview-card
            h3 Overview
            .scroll-list
              .overview-row
                span Tips Created
                strong= stats.tipsCreated
              .overview-row
                span Tips Saved
                strong= stats.tipsSaved
              .overview-row
                span Tips Liked
                strong= stats.tipsLiked
              .overview-row
                span Events Joined
                strong= stats.eventsJoined
              .overview-row
                span Events Completed
                strong= stats.eventsCompleted

          .graph-card
            h3 Activity
            p.activity-note Profile activity overview based on user content and engagement.
            .graph-grid
              if activityBoxes && activityBoxes.length
                each box in activityBoxes
                  span(class=`graph-box level-${box.level}`, title=`Activity value: ${box.value}`)
              else
                each _ in [1, 2, 3, 4, 5, 6, 7, 8]
                  span.graph-box.level-1

      .profile-bottom
        .profile-section
          h3 My Tips
          if tips && tips.length
            .scroll-list
              each tip in tips
                .content-card
                  h4
                    a.card-link(href='/guide-details/' + tip.gid)= tip.title
                  p
                    strong Game:
                    |  #{tip.game}
                  p
                    strong Date:
                    |  #{tip.date}
                  p= tip.summary
          else
            .content-card.empty-state
              h4 No tips yet
              p This user has not created any tips yet.

        .profile-section
          h3 Upcoming Events
          if upcomingEvents && upcomingEvents.length
            .scroll-list
              each event in upcomingEvents
                .content-card
                  h4
                    a.card-link(href='/events/' + event.id)= event.name
                  p
                    strong Date:
                    |  #{event.date}
                  p
                    strong Skill Level:
                    |  #{event.skillLevel}
          else
            .content-card.empty-state
              h4 No upcoming events
              p This user has no upcoming events right now.

        .profile-section
          h3 Completed Events
          if completedEvents && completedEvents.length
            .scroll-list
              each event in completedEvents
                .content-card
                  h4
                    a.card-link(href='/events/' + event.id)= event.name
                  p
                    strong Date:
                    |  #{event.date}
                  p
                    strong Skill Level:
                    |  #{event.skillLevel}
          else
            .content-card.empty-state
              h4 No completed events
              p This user has not completed any events yet.

  script.
    document.querySelectorAll('.scroll-list').forEach(function(el) {
      var isDown = false, startY, scrollTop;
      el.addEventListener('mousedown', function(e) {
        isDown = true;
        startY = e.pageY - el.getBoundingClientRect().top;
        scrollTop = el.scrollTop;
        el.style.cursor = 'grabbing';
      });
      window.addEventListener('mouseup', function() {
        isDown = false;
        el.style.cursor = 'grab';
      });
      el.addEventListener('mousemove', function(e) {
        if (!isDown) return;
        e.preventDefault();
        var y = e.pageY - el.getBoundingClientRect().top;
        el.scrollTop = scrollTop - (y - startY) * 1.5;
      });
    });

extends websitelayout

block styles 
  link(rel="stylesheet", href="/style/guides.css")

block content
   .guide-detail-page
      .guide-detail-back
        a(href="/guides") ← Guides

      .guide-detail-header
            h1=guide.title
            .guide-detail-rating
              span ⭐4.5

      .guide-detail-tags
            span.tag=guide.genre
            span.tag=guide.skillLevel

      p Created at #{guide.createdAt}

      .guide-detail-layout
        section.guide-detail-content
          .guide-detail-text
            p=guide.content

        aside.guide-detail-comments

          .guide-detail-comments-box
            h2 Comments
            input.guide-detail-input(type="text" placeholder="Write a comments...")

            each comment in guide.comments
              .guide-detail-comment
                .guide-detail-avatar
                .guide-detail-comment-body
                  h3 #{comment.username}
                  p #{comment.comment}
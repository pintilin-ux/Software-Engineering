extends websitelayout

block styles 
  link(rel="stylesheet", href="/style/guides.css")

block content
    .container

      // FILTER SIDEBAR
      aside.filters
        h2 Filters
        form(method="GET", action="/guides")
          input(type="hidden" name="search" value=search)

          label(for="skillLevel") Skill level
          select(name="skillLevel" id="skillLevel")
            option(value="All" selected=skillLevel === "All") All
            option(value="Beginner" selected=skillLevel === "Beginner") Beginner
            option(value="Intermediate" selected=skillLevel === "Intermediate") Intermediate
            option(value="Advanced" selected=skillLevel === "Advanced") Advanced

          label(for="genre") Genre
          select(name="genre" id="genre")
            option(value="All" selected=genre === "All") All
            option(value="Strategy" selected=genre === "Strategy") Strategy
            option(value="Cooking" selected=genre === "Cooking") Cooking
            option(value="Programming" selected=genre === "Programming") Programming
            option(value="Gaming" selected=genre === "Gaming") Gaming

          button.btn(type="submit") Filter
          a.btn(href="/guides") Reset

      // GUIDES SECTION
      section.guides

        h1 Guides
        form.search-form(method="GET", action="/guides")
          input(type="hidden" name="skillLevel" value=skillLevel)
          input(type="hidden" name="genre" value=genre)
          .search-wrapper
            input(type="text" name="search" placeholder="Search..." value=search)
            button(type="submit")
              img(src="/images/search-icon.svg", alt="Search")

        .guides-grid
          each guide in guides
            .guide-card
              .guide-info-wrap 
                p.guide-card-title= guide.title
                .likes-container 
                  img(src="/images/Like_icon.svg")
                  p.like-number 5
              .guide-card-tags
                span.tag.tag--skill= guide.skillLevel
                span.tag.tag--category= guide.genre
              p.guide-content= guide.getShortContent()
              a.btn(href="/guide-details/" + guide.id) Read Guide